<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Xm4Control.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Accent fixe, le bleu de l'icône (palette bleue par défaut de Windows 11) : l'accent système
                peut être gris, et le mode actif ou les interrupteurs auraient l'air désactivés.
            -->
            <Color x:Key="SystemAccentColor">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#FF0091F8</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4CC2FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0067C0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
            <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>

            <!-- Couleurs des modes, les mêmes que la fenêtre principale (Web/app.css). -->
            <SolidColorBrush x:Key="ModeInk" Color="#FF0B0D10" />
            <SolidColorBrush x:Key="NoiseBrush" Color="#FF8EC5FF" />
            <SolidColorBrush x:Key="AmbientBrush" Color="#FFF2C27B" />
            <SolidColorBrush x:Key="WindBrush" Color="#FF7FD8C8" />
            <SolidColorBrush x:Key="OffBrush" Color="#FFA3ACB8" />

            <!-- Tuile de mode du popup : transparente, remplie de la couleur du mode quand elle est active. -->
            <Style x:Key="ModeTileStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                <Setter Property="Height" Value="62" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="2,4" />
            </Style>

            <!-- Bascule rapide du popup (micro, Speak-to-Chat) : l'état se lit sur le petit interrupteur dessiné. -->
            <Style x:Key="QuickTileStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,12,12,10" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
