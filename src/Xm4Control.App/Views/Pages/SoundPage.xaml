<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Xm4Control.App.Views.Pages.SoundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Xm4Control.App.Views">
    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="36,8,36,36"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" Text="Son ambiant" />
            <views:StatusBanner />

            <!-- Modes en tuiles carrées, comme les réglages rapides de Windows. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    Click="OnNoiseCancelling"
                    IsChecked="{x:Bind ViewModel.IsNoiseCancelling, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Style="{StaticResource PageModeTileStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Height="30" FontSize="24" Glyph="&#xE7F6;" />
                        <TextBlock Text="Réduction de bruit" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Grid.Column="1"
                    Click="OnAmbient"
                    IsChecked="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Style="{StaticResource PageModeTileStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Height="30" FontSize="24" Glyph="&#xE767;" />
                        <TextBlock Text="Son ambiant" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Grid.Column="2"
                    Click="OnWindReduction"
                    IsChecked="{x:Bind ViewModel.IsWindReduction, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Style="{StaticResource PageModeTileStyle}">
                    <StackPanel Spacing="8">
                        <!-- Pas de pictogramme "vent" dans Segoe Fluent Icons : ≋ de Segoe UI Symbol. -->
                        <FontIcon Height="30" FontFamily="Segoe UI Symbol" FontSize="30" Glyph="&#x224B;" />
                        <TextBlock Text="Réduction du vent" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Grid.Column="3"
                    Click="OnOff"
                    IsChecked="{x:Bind ViewModel.IsOff, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Style="{StaticResource PageModeTileStyle}">
                    <StackPanel Spacing="8">
                        <FontIcon Height="30" FontSize="24" Glyph="&#xE711;" />
                        <TextBlock Text="Désactivé" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <toolkit:SettingsCard
                Margin="0,8,0,0"
                Description="Quantité de son extérieur laissée passer, de 1 à 20."
                Header="Niveau du son ambiant"
                IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider
                        Width="220"
                        VerticalAlignment="Center"
                        Maximum="20"
                        Minimum="1"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.AmbientLevelValue, Mode=TwoWay}" />
                    <TextBlock
                        Width="20"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.AmbientLevel, Mode=OneWay}"
                        TextAlignment="Right" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                Description="Laisse passer les voix en atténuant les autres bruits."
                Header="Focus sur la voix"
                IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.FocusOnVoice, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Optimiseur de réduction de bruit" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="Adapte la réduction de bruit à votre tête, vos lunettes et à la pression atmosphérique (avion). Portez le casque et restez immobile une quinzaine de secondes." TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.OptimizerStatus, Mode=OneWay}"
                            Visibility="{x:Bind views:Ui.Show(ViewModel.HasOptimizerStatus), Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard.Description>
                <Button MinWidth="96" Click="OnToggleOptimizer" Content="{x:Bind ViewModel.OptimizerButtonText, Mode=OneWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Micro" />
            <toolkit:SettingsCard
                Description="Coupé, le casque reste en stéréo haute qualité : Windows ne le bascule plus en mode « téléphone » quand une appli ouvre le micro (Teams, Discord…), mais son micro n'est plus utilisable."
                Header="Micro du casque (profil mains libres de Windows)"
                IsEnabled="{x:Bind ViewModel.MicAvailable, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE720;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.MicEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
