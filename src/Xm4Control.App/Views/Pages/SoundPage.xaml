<Page
    x:Class="Xm4Control.App.Views.Pages.SoundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:protocol="clr-namespace:Xm4Control.Core.Protocol;assembly=Xm4Control.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Xm4Control.App.Views"
    Title="Son ambiant">
    <StackPanel Margin="24,12,24,24">
        <ui:TextBlock Margin="0,0,0,16" FontTypography="Title" Text="Son ambiant" />
        <views:StatusBanner />

        <Grid Margin="0,0,-8,0" IsEnabled="{Binding IsConnected}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ToggleButton CommandParameter="{x:Static protocol:AmbientMode.NoiseCancelling}" IsChecked="{Binding IsNoiseCancelling, Mode=OneWay}" Style="{StaticResource ModeTile}">
                <StackPanel>
                    <ui:SymbolIcon Margin="0,0,0,6" FontSize="22" Symbol="Headphones24" />
                    <TextBlock Text="Réduction de bruit" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Grid.Column="1" CommandParameter="{x:Static protocol:AmbientMode.Ambient}" IsChecked="{Binding IsAmbient, Mode=OneWay}" Style="{StaticResource ModeTile}">
                <StackPanel>
                    <ui:SymbolIcon Margin="0,0,0,6" FontSize="22" Symbol="HeadphonesSoundWave24" />
                    <TextBlock Text="Son ambiant" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Grid.Column="2" CommandParameter="{x:Static protocol:AmbientMode.WindReduction}" IsChecked="{Binding IsWindReduction, Mode=OneWay}" Style="{StaticResource ModeTile}">
                <StackPanel>
                    <ui:SymbolIcon Margin="0,0,0,6" FontSize="22" Symbol="WeatherSqualls24" />
                    <TextBlock Text="Réduction du vent" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Grid.Column="3" CommandParameter="{x:Static protocol:AmbientMode.Off}" IsChecked="{Binding IsOff, Mode=OneWay}" Style="{StaticResource ModeTile}">
                <StackPanel>
                    <ui:SymbolIcon Margin="0,0,0,6" FontSize="22" Symbol="Prohibited24" />
                    <TextBlock Text="Désactivé" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <ui:CardControl Margin="0,16,0,0" Icon="{ui:SymbolIcon SoundWaveCircle24}" IsEnabled="{Binding IsAmbient}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Niveau du son ambiant" />
                    <TextBlock Style="{StaticResource Description}" Text="Quantité de son extérieur laissée passer, de 1 à 20." />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider
                    Width="220"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="20"
                    Minimum="1"
                    TickFrequency="1"
                    Value="{Binding AmbientLevel, Delay=300}" />
                <TextBlock Width="28" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding AmbientLevel}" TextAlignment="Right" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon PersonVoice24}" IsEnabled="{Binding IsAmbient}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Focus sur la voix" />
                    <TextBlock Style="{StaticResource Description}" Text="Laisse passer les voix en atténuant les autres bruits." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding FocusOnVoice}" />
        </ui:CardControl>

        <ui:TextBlock Margin="0,24,0,8" FontTypography="BodyStrong" Text="Micro" />
        <ui:CardControl Icon="{ui:SymbolIcon Mic24}" IsEnabled="{Binding MicAvailable}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Micro du casque (profil mains libres de Windows)" />
                    <TextBlock Style="{StaticResource Description}" Text="Coupé, le casque reste en stéréo haute qualité : Windows ne le bascule plus en mode « téléphone » quand une appli ouvre le micro (Teams, Discord…), mais son micro n'est plus utilisable." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding MicEnabled}" />
        </ui:CardControl>
    </StackPanel>
</Page>
