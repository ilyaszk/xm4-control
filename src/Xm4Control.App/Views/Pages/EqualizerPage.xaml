<Page
    x:Class="Xm4Control.App.Views.Pages.EqualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Xm4Control.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Xm4Control.App.Views"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Égaliseur">
    <StackPanel Margin="24,12,24,24">
        <ui:TextBlock Margin="0,0,0,16" FontTypography="Title" Text="Égaliseur" />
        <views:StatusBanner />

        <ListBox
            IsEnabled="{Binding IsConnected}"
            ItemContainerStyle="{StaticResource ChipItem}"
            ItemsSource="{Binding Presets}"
            SelectedItem="{Binding SelectedPreset}">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ui:Card Margin="0,8,0,0" Padding="8,16,8,12">
            <controls:EqualizerCurve
                Height="260"
                AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                HandleBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                IsEnabled="{Binding IsConnected}"
                LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                TextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                Values="{Binding EqualizerBands}" />
        </ui:Card>
        <TextBlock
            Margin="2,8,0,0"
            Style="{StaticResource Description}"
            Text="Faites glisser les points ou utilisez la molette. Toucher aux bandes passe en préréglage Manuel, comme dans l'appli Sony." />
    </StackPanel>
</Page>
