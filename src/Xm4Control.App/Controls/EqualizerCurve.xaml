<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Xm4Control.App.Controls.EqualizerCurve"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Les éléments ci-dessous portent les couleurs du thème (ThemeResource) ; les poignées et libellés,
        créés par le code, les recopient à chaque changement de thème.
    -->
    <Canvas
        x:Name="Surface"
        Background="Transparent"
        PointerCaptureLost="OnPointerCaptureLost"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerWheelChanged="OnPointerWheelChanged">
        <Line
            x:Name="ZeroLine"
            Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
            StrokeDashArray="4,4"
            StrokeThickness="1" />
        <Path x:Name="FillPath" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
        <Path
            x:Name="StrokePath"
            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
            StrokeThickness="2.5" />
        <Ellipse
            x:Name="HandleTemplate"
            Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="TextTemplate"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />
    </Canvas>
</UserControl>
