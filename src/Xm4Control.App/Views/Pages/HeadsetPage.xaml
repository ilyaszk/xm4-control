<Page
    x:Class="Xm4Control.App.Views.Pages.HeadsetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Xm4Control.App.Views"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Casque">
    <StackPanel Margin="24,12,24,24">
        <ui:TextBlock Margin="0,0,0,16" FontTypography="Title" Text="Casque" />
        <views:StatusBanner />

        <ui:Card Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,3,32,3" Style="{StaticResource Description}" Text="Appareil" />
                <TextBlock Grid.Column="1" Margin="0,3" Text="{Binding DeviceName}" />
                <TextBlock Grid.Row="1" Margin="0,3,32,3" Style="{StaticResource Description}" Text="Batterie" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding BatteryDetail}" />
                <TextBlock Grid.Row="2" Margin="0,3,32,3" Style="{StaticResource Description}" Text="Codec" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Codec}" />
                <TextBlock Grid.Row="3" Margin="0,3,32,3" Style="{StaticResource Description}" Text="Firmware" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding Firmware}" />
            </Grid>
        </ui:Card>

        <ui:TextBlock Margin="0,24,0,8" FontTypography="BodyStrong" Text="Fonctions" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Sparkle24}" IsEnabled="{Binding HasDsee}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="DSEE Extreme" />
                    <TextBlock Style="{StaticResource Description}" Text="Restaure les détails perdus par la compression de la musique." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Dsee}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Chat24}" IsEnabled="{Binding HasSpeakToChat}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Speak-to-Chat" />
                    <TextBlock Style="{StaticResource Description}" Text="Met la musique en pause et laisse passer le son quand vous parlez." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding SpeakToChat}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PauseCircle24}" IsEnabled="{Binding HasPauseWhenTakenOff}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Pause au retrait du casque" />
                    <TextBlock Style="{StaticResource Description}" Text="Met la lecture en pause quand vous enlevez le casque." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding PauseWhenTakenOff}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TapSingle24}" IsEnabled="{Binding HasTouchSensor}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Pavé tactile" />
                    <TextBlock Style="{StaticResource Description}" Text="Commandes tactiles sur l'écouteur droit." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding TouchSensor}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Speaker224}" IsEnabled="{Binding HasVoiceGuidance}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Guide vocal" />
                    <TextBlock Style="{StaticResource Description}" Text="Annonces vocales du casque (connexion, batterie, mode…)." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding VoiceGuidance}" />
        </ui:CardControl>

        <ui:Button
            Margin="0,20,0,0"
            Appearance="Danger"
            Click="OnPowerOff"
            Content="Éteindre le casque"
            Icon="{ui:SymbolIcon Power24}"
            IsEnabled="{Binding IsConnected}" />
    </StackPanel>
</Page>
