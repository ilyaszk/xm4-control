<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Xm4Control.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="XM4 Control">

    <!-- Fenêtre toujours sombre, au fond de la page web (variable ground de Web/app.css) : barre de titre native au-dessus. -->
    <Grid Background="#FF07090C" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="XM4 Control" />

        <WebView2
            x:Name="Web"
            Grid.Row="1"
            DefaultBackgroundColor="#FF07090C" />
    </Grid>
</Window>
