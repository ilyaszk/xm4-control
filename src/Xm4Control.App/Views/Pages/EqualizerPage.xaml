<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Xm4Control.App.Views.Pages.EqualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Xm4Control.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Xm4Control.App.Views">
    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="36,8,36,36"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" Text="Égaliseur" />
            <views:StatusBanner />

            <toolkit:SettingsCard
                Description="Les préréglages Sony, ou Manuel pour régler vous-même les bandes."
                Header="Préréglage"
                IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.PresetLabels}"
                    SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <Border
                Margin="0,4,0,0"
                Padding="8,16,8,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <controls:EqualizerCurve
                    Height="280"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Values="{x:Bind ViewModel.EqualizerBands, Mode=TwoWay}" />
            </Border>
            <TextBlock
                Margin="2,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Faites glisser les points ou utilisez la molette. Toucher aux bandes passe en préréglage Manuel, comme dans l'appli Sony."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
