<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Xm4Control.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Xm4Control.App.Views"
    Title="XM4 Control">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Le ScrollViewer laisse le contenu prendre sa hauteur naturelle : la fenêtre s'y ajuste. -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel
            x:Name="Root"
            Padding="16"
            VerticalAlignment="Top"
            Spacing="12">
            <!-- En-tête : casque, état, batterie -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="28" Glyph="&#xE7F6;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind views:Ui.Show(ViewModel.HasBattery), Mode=OneWay}">
                    <FontIcon FontSize="18" Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- Modes -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton Click="OnNoiseCancelling" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsNoiseCancelling, Mode=OneWay}" Style="{StaticResource ModeTileStyle}">
                    <StackPanel Spacing="6">
                        <FontIcon Height="26" FontSize="20" Glyph="&#xE7F6;" />
                        <TextBlock FontSize="12" Text="Réduction de bruit" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1" Click="OnAmbient" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsAmbient, Mode=OneWay}" Style="{StaticResource ModeTileStyle}">
                    <StackPanel Spacing="6">
                        <FontIcon Height="26" FontSize="20" Glyph="&#xE767;" />
                        <TextBlock FontSize="12" Text="Son ambiant" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="2" Click="OnWindReduction" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsWindReduction, Mode=OneWay}" Style="{StaticResource ModeTileStyle}">
                    <StackPanel Spacing="6">
                        <FontIcon Height="26" FontFamily="Segoe UI Symbol" FontSize="24" Glyph="&#x224B;" />
                        <TextBlock FontSize="12" Text="Vent" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="3" Click="OnOff" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsOff, Mode=OneWay}" Style="{StaticResource ModeTileStyle}">
                    <StackPanel Spacing="6">
                        <FontIcon Height="26" FontSize="20" Glyph="&#xE711;" />
                        <TextBlock FontSize="12" Text="Désactivé" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- Niveau du son ambiant, utile seulement en mode son ambiant -->
            <Border
                Padding="14,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="{x:Bind views:Ui.Dim(ViewModel.IsAmbient), Mode=OneWay}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Niveau du son ambiant" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.AmbientLevel, Mode=OneWay}" />
                    </Grid>
                    <Slider
                        IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                        Maximum="20"
                        Minimum="1"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.AmbientLevelValue, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Text="Focus sur la voix" />
                        <ToggleSwitch
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.FocusOnVoice, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Micro -->
            <Border
                Padding="14,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE720;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Micro du casque" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Coupé : stéréo HD en permanence" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        IsEnabled="{x:Bind ViewModel.MicAvailable, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.MicEnabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </Grid>
            </Border>

            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind views:Ui.Show(ViewModel.HasError), Mode=OneWay}" />

            <!-- Pied : égaliseur et réglages -->
            <Grid>
                <Button Click="OnOpenEqualizer" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                        <TextBlock Text="{x:Bind ViewModel.EqualizerLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Right" Click="OnOpenSettings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock Text="Réglages" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
