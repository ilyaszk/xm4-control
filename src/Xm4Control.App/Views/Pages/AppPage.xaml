<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Xm4Control.App.Views.Pages.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:Xm4Control.App.Views">
    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="36,8,36,36"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" Text="Application" />

            <toolkit:SettingsCard Description="L'appli démarre dans la zone de notification, sans fenêtre." Header="Lancer au démarrage de Windows">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Raccourci clavier Ctrl + Alt + N">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Description>
                    <StackPanel>
                        <TextBlock Text="Depuis n'importe quelle appli : réduction de bruit → son ambiant → désactivé." TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind views:Ui.Show(ViewModel.HasHotkeyError), Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard.Description>
                <ToggleSwitch IsOn="{x:Bind ViewModel.HotkeyEnabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Notification Windows quand la batterie du casque passe sous 20 %." Header="Alerte batterie faible">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE850;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.LowBatteryAlert, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="À propos" />
            <toolkit:SettingsCard Description="Contrôle du Sony WH-1000XM4 sous Windows, sans l'appli mobile. Logiciel libre sous licence MIT, non affilié à Sony.">
                <toolkit:SettingsCard.Header>
                    <TextBlock>
                        <Run Text="XM4 Control" />
                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Version}" />
                    </TextBlock>
                </toolkit:SettingsCard.Header>
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </toolkit:SettingsCard.HeaderIcon>
                <HyperlinkButton Content="Code source sur GitHub" NavigateUri="https://github.com/ilyaszk/xm4-control" />
            </toolkit:SettingsCard>

            <Button Margin="0,20,0,0" Click="OnQuit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                    <TextBlock Text="Quitter XM4 Control" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
