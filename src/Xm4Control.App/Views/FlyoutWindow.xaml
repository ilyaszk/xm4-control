<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Xm4Control.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Xm4Control.App.Views"
    Title="XM4 Control">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Le ScrollViewer laisse le contenu prendre sa hauteur naturelle : la fenêtre s'y ajuste. -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel
            x:Name="Root"
            Padding="16"
            VerticalAlignment="Top"
            Spacing="12">

            <!-- En-tête : petit casque avec halo, mode, batterie -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="76" Height="76">
                    <Ellipse Margin="-6" Fill="{x:Bind ModeGlow(ViewModel.IsConnected, ViewModel.IsNoiseCancelling, ViewModel.IsAmbient, ViewModel.IsWindReduction), Mode=OneWay}" />
                    <Image
                        x:Name="Headset"
                        AutomationProperties.Name="{x:Bind HeadsetText}"
                        Opacity="{x:Bind views:Ui.Dim(ViewModel.IsConnected), Mode=OneWay}"
                        Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        CharacterSpacing="100"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DeviceCaps(ViewModel.DeviceName), Mode=OneWay}" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="23"
                        FontWeight="Light"
                        Text="{x:Bind ModeTitle(ViewModel.IsConnected, ViewModel.IsNoiseCancelling, ViewModel.IsAmbient, ViewModel.IsWindReduction, ViewModel.IsOff), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{x:Bind StatusDot(ViewModel.IsConnected), Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <!-- Batterie : anneau et pourcentage -->
                <Grid
                    Grid.Column="2"
                    Width="46"
                    Height="46"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind views:Ui.Show(ViewModel.HasBattery), Mode=OneWay}">
                    <ProgressRing
                        Width="46"
                        Height="46"
                        Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                        Foreground="#FF3DCC8A"
                        IsIndeterminate="False"
                        Maximum="100"
                        Value="{x:Bind ViewModel.BatteryLevel, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind BatteryNumber(ViewModel.BatteryLevel), Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- Modes : quatre tuiles dans un bandeau, description du mode actif dessous -->
            <StackPanel Spacing="6">
                <Border
                    Padding="5"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            AutomationProperties.Name="{x:Bind NoiseCancellingText}"
                            Click="OnNoiseCancelling"
                            IsChecked="{x:Bind ViewModel.IsNoiseCancelling, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Style="{StaticResource ModeTileStyle}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="NoiseBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="NoiseBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="NoiseBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ModeInk" />
                            </ToggleButton.Resources>
                            <StackPanel Spacing="5">
                                <FontIcon FontSize="18" Glyph="&#xE7F6;" />
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{x:Bind NoiseTile}" TextAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind AmbientSoundText}"
                            Click="OnAmbient"
                            IsChecked="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Style="{StaticResource ModeTileStyle}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AmbientBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AmbientBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AmbientBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ModeInk" />
                            </ToggleButton.Resources>
                            <StackPanel Spacing="5">
                                <FontIcon FontSize="18" Glyph="&#xE767;" />
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{x:Bind AmbientTile}" TextAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Grid.Column="2"
                            AutomationProperties.Name="{x:Bind WindText}"
                            Click="OnWindReduction"
                            IsChecked="{x:Bind ViewModel.IsWindReduction, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Style="{StaticResource ModeTileStyle}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="WindBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="WindBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="WindBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ModeInk" />
                            </ToggleButton.Resources>
                            <StackPanel Spacing="5">
                                <!-- Pas de pictogramme "vent" dans Segoe Fluent Icons : ≋ de Segoe UI Symbol. -->
                                <FontIcon FontFamily="Segoe UI Symbol" FontSize="20" Glyph="&#x224B;" />
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{x:Bind WindTile}" TextAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Grid.Column="3"
                            AutomationProperties.Name="{x:Bind OffText}"
                            Click="OnOff"
                            IsChecked="{x:Bind ViewModel.IsOff, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                            Style="{StaticResource ModeTileStyle}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="OffBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="OffBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="OffBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ModeInk" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ModeInk" />
                            </ToggleButton.Resources>
                            <StackPanel Spacing="5">
                                <FontIcon FontSize="18" Glyph="&#xE711;" />
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{x:Bind OffTile}" TextAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Border>
                <TextBlock
                    Margin="4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ModeHint(ViewModel.IsConnected, ViewModel.IsNoiseCancelling, ViewModel.IsAmbient, ViewModel.IsWindReduction, ViewModel.IsOff), Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Son ambiant : réglable seulement en mode Son ambiant -->
            <Border
                Padding="14,10,14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Opacity="{x:Bind views:Ui.Dim(ViewModel.IsAmbient), Mode=OneWay}">
                <Border.Resources>
                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="SliderThumbBackground" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AmbientBrush" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="ModeInk" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="ModeInk" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="ModeInk" />
                </Border.Resources>
                <StackPanel>
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind AmbientSoundText}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind AmbientText(ViewModel.AmbientLevel), Mode=OneWay}" />
                    </Grid>
                    <Slider
                        AutomationProperties.Name="{x:Bind AmbientLevelText}"
                        IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                        Maximum="20"
                        Minimum="1"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.AmbientLevelValue, Mode=TwoWay}" />
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind AmbientFoot(ViewModel.IsAmbient), Mode=OneWay}" />
                        <ToggleSwitch
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{x:Bind FocusOnVoiceText}"
                            IsEnabled="{x:Bind ViewModel.IsAmbient, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.FocusOnVoice, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Deux bascules rapides : micro et Speak-to-Chat -->
            <Grid ColumnSpacing="8">
                <Grid.Resources>
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlStrokeColorDefaultBrush" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    AutomationProperties.Name="{x:Bind MicName}"
                    Click="OnToggleMic"
                    IsChecked="{x:Bind ViewModel.MicEnabled, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.MicAvailable, Mode=OneWay}"
                    Style="{StaticResource QuickTileStyle}">
                    <StackPanel Spacing="3">
                        <Grid Margin="0,0,0,4">
                            <FontIcon HorizontalAlignment="Left" FontSize="16" Glyph="&#xE720;" />
                            <Border
                                Width="36"
                                Height="20"
                                Padding="3"
                                HorizontalAlignment="Right"
                                Background="{x:Bind TrackBrush(ViewModel.MicEnabled), Mode=OneWay}"
                                CornerRadius="10">
                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="{x:Bind KnobSide(ViewModel.MicEnabled), Mode=OneWay}"
                                    Fill="{x:Bind KnobBrush(ViewModel.MicEnabled), Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind MicTile}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind MicHint(ViewModel.MicEnabled), Mode=OneWay}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Grid.Column="1"
                    AutomationProperties.Name="Speak-to-Chat"
                    Click="OnToggleSpeakToChat"
                    IsChecked="{x:Bind ViewModel.SpeakToChat, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSpeakToChat, Mode=OneWay}"
                    Style="{StaticResource QuickTileStyle}">
                    <StackPanel Spacing="3">
                        <Grid Margin="0,0,0,4">
                            <FontIcon HorizontalAlignment="Left" FontSize="16" Glyph="&#xE8BD;" />
                            <Border
                                Width="36"
                                Height="20"
                                Padding="3"
                                HorizontalAlignment="Right"
                                Background="{x:Bind TrackBrush(ViewModel.SpeakToChat), Mode=OneWay}"
                                CornerRadius="10">
                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="{x:Bind KnobSide(ViewModel.SpeakToChat), Mode=OneWay}"
                                    Fill="{x:Bind KnobBrush(ViewModel.SpeakToChat), Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="Speak-to-Chat" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SpeakToChatHint}" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind views:Ui.Show(ViewModel.HasError), Mode=OneWay}" />

            <!-- Pied : égaliseur et fenêtre principale -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    MinHeight="44"
                    Padding="12,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="{x:Bind EqualizerText}"
                    Click="OnOpenEqualizer"
                    CornerRadius="10"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind EqualizerText}" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.EqualizerLabel, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    MinHeight="44"
                    Padding="14,4"
                    AutomationProperties.Name="{x:Bind OpenAppText}"
                    Click="OnOpenSettings"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind OpenAppText}" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
