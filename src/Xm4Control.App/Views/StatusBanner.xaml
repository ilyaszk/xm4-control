<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Xm4Control.App.Views.StatusBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bandeaux "casque non connecté" et "erreur", en tête de chaque page de réglages. -->
    <StackPanel Spacing="8">
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.ShowDisconnected, Mode=OneWay}"
            Message="{x:Bind ViewModel.DisconnectedHint, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error"
            Title="Erreur" />
    </StackPanel>
</UserControl>
