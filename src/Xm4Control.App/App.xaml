<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Xm4Control.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Accent fixe, le bleu de l'icône (palette bleue par défaut de Windows 11) : l'accent système
                peut être gris, et le mode actif ou les interrupteurs auraient l'air désactivés.
            -->
            <Color x:Key="SystemAccentColor">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#FF0091F8</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4CC2FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0067C0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
            <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>

            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <!-- Titre de section, comme dans l'app Paramètres de Windows. -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>

            <!-- Tuile de mode du popup (réduction de bruit, son ambiant…). -->
            <Style x:Key="ModeTileStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
                <Setter Property="Height" Value="78" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="2,4" />
            </Style>

            <!-- Même tuile, plus grande, pour la page Son ambiant des réglages. -->
            <Style x:Key="PageModeTileStyle" BasedOn="{StaticResource ModeTileStyle}" TargetType="ToggleButton">
                <Setter Property="Height" Value="104" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
